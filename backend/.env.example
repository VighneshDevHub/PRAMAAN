# PRAMAAN Backend Environment Variables
# Copy this file to .env inside the backend/ directory for local development.

# Application Environment (development / production)
ENVIRONMENT=development

# Database Connection URL
# Local SQLite default: sqlite+aiosqlite:///./forensicguard.db
# Cloud PostgreSQL example: postgresql+asyncpg://user:password@ep-sample.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./forensicguard.db

# JWT Authentication Secret Key (Generate a random 64-character string for production)
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend Public Base URL (Used for CORS and verification QR links)
PUBLIC_BASE_URL=http://localhost:3000

# Additional CORS Origins (Comma-separated URLs if deploying on custom domain)
EXTRA_CORS_ORIGINS=http://localhost:3000,https://pramaan.vercel.app
